datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Candidate {
  id                String   @id @default(uuid())
  name              String
  jobRole           String
  yearsExperience   Float
  education         String
  status            String
  email             String   @unique
  passwordHash      String
  resumeText        String?
  isSeedProfile     Boolean  @default(false)
  createdAt         DateTime @default(now())

  missions          Mission[]
  signals           Signal?
  interviews        Interview[]
}

model Mission {
  id            String   @id @default(uuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  day           Int
  title         String
  passed        Boolean
  skipped       Boolean
  attempts      Int
}

model Signal {
  id                  String   @id @default(uuid())
  candidateId         String   @unique
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  commitDays          Int
  missionsCompleted   Int
  missionsFirstTry    Int
}

model Interview {
  id             String   @id @default(uuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  difficulty     String
  status         String
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  turns          Turn[]
  report         Report?
}

model Turn {
  id             String   @id @default(uuid())
  interviewId    String
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role           String
  content        String
  day            Int?
  isFollowUp     Boolean  @default(false)
  correctness    Float?
  gradeNotes     String?
  createdAt      DateTime @default(now())
}

model Report {
  id                String   @id @default(uuid())
  interviewId       String   @unique
  interview         Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore      Float
  summary           String
  strengths         String
  gaps              String
  next              String
  categoryBreakdown String
  createdAt         DateTime @default(now())
}
